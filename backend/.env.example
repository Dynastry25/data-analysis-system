# StatFlow backend environment variables.
#
# Copy this file to `backend/.env` and fill in values for a PRODUCTION run
# (e.g. pointing at your Render Postgres database). Local development uses the
# sqlite default unless you uncomment DATABASE_URL, so nothing here is required
# to develop on your machine.

# --- Production database (Render Postgres) ---
# Get this URL from Render → your Postgres → "Internal Database URL" (or
# "External" if you connect from outside Render). Leave commented out for local
# dev, which keeps the default sqlite (backend/app.db).
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME

# --- Auth ---
# Long random string: openssl rand -hex 32 (or use one generated by Render).
# SECRET_KEY=change-me-in-production

# --- CORS ---
# Comma-separated list of origins allowed to call this API.
# Local dev default is http://localhost:3000.
# FRONTEND_ORIGIN=https://your-app.vercel.app,http://localhost:3000

# --- Storage ---
# Where uploaded files + generated reports live.
# STORAGE_DIR=/var/data/storage